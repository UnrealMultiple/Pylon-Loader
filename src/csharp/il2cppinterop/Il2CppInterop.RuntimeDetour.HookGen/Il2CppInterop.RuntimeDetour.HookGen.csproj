<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Il2CppInterop.RuntimeDetour.HookGen —— 把 On.* 钩子直接用 Cecil 发 IL 写进代理程序集。
    不生成 C# 源码、不经过 Roslyn；每个 On.X.Y 事件就是一个强类型委托 + add/remove 方法。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Il2CppInterop.RuntimeDetour.HookGen</AssemblyName>
    <RootNamespace>Il2CppInterop.RuntimeDetour.HookGen</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Il2CppInterop.RuntimeDetour\Il2CppInterop.RuntimeDetour.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
