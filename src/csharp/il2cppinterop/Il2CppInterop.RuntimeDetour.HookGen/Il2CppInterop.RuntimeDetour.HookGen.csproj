<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Il2CppInterop.RuntimeDetour.HookGen: writes On.* hooks straight into the proxy assemblies
    as IL via Cecil. No C# source is generated and Roslyn is not involved; every On.X.Y event
    is a strongly typed delegate + add/remove method.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Il2CppInterop.RuntimeDetour.HookGen</AssemblyName>
    <RootNamespace>Il2CppInterop.RuntimeDetour.HookGen</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Il2CppInterop.RuntimeDetour\Il2CppInterop.RuntimeDetour.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>