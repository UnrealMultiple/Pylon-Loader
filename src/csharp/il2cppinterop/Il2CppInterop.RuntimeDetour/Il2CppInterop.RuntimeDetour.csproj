<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Il2CppInterop.RuntimeDetour —— 唯一一套 hook 引擎（MonoMod 形状）。
    · 引擎本身不碰任何原生 detour 实现：宿主（Pylon）实现 DetourBackend 接内核 Dobby。
    · On.* 钩子由 Il2CppInterop.RuntimeDetour.HookGen 直接发 IL 写进代理程序集。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Il2CppInterop.RuntimeDetour</AssemblyName>
    <RootNamespace>Il2CppInterop.RuntimeDetour</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Il2CppInterop.Runtime\Il2CppInterop.Runtime.csproj" />
    <ProjectReference Include="..\Il2CppInterop.Common\Il2CppInterop.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>hookprobe</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
