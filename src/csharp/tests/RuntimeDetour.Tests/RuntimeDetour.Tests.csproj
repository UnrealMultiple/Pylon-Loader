<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>hookprobe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup><Compile Remove="obj/**/*.cs;bin/**/*.cs" /></ItemGroup>
  <ItemGroup Condition="'$(HookTestRuntimeDir)' == ''">
    <ProjectReference Include="../../il2cppinterop/Il2CppInterop.RuntimeDetour/Il2CppInterop.RuntimeDetour.csproj" />
  </ItemGroup>
  <!-- Offline fallback compiles CURRENT engine sources, referencing only the supplied runtime
       dependencies. No old RuntimeDetour binary is tested. -->
  <ItemGroup Condition="'$(HookTestRuntimeDir)' != ''">
    <Compile Include="../../il2cppinterop/Il2CppInterop.RuntimeDetour/*.cs" Link="Engine/%(Filename)%(Extension)" />
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(HookTestRuntimeDir)/Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(HookTestRuntimeDir)/Il2CppInterop.Common.dll</HintPath></Reference>
  </ItemGroup>
</Project>
