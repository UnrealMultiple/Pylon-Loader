<Project>
  <PropertyGroup><BaseIntermediateOutputPath>obj/shim/</BaseIntermediateOutputPath><MSBuildProjectExtensionsPath>obj/shim/</MSBuildProjectExtensionsPath></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><NuGetAudit>false</NuGetAudit>
    <DefineConstants>$(DefineConstants);HOOK_TEST_SHIM</DefineConstants>
    <OutputPath>bin/shim/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../il2cppinterop/Il2CppInterop.RuntimeDetour/*.cs" />
    <Compile Include="Program.cs;BindingTests.cs;RuntimeShim.cs;BoxedTests.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
