<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Execute the production implementation with a deterministic IL2CPP test double. -->
    <Compile Include="../../il2cppinterop/Il2CppInterop.Runtime/GuardedInvoke.cs" Link="GuardedInvoke.cs" />
  </ItemGroup>
</Project>
