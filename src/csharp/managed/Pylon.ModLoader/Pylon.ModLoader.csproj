<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Pylon.ModLoader</AssemblyName>
    <RootNamespace>Pylon.ModLoader</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pylon.Mod.Abstractions\Pylon.Mod.Abstractions.csproj" />

    <!-- 唯一一套 hook：引擎与 On.* 都在 Il2CppInterop 里（On.* 直接生成进代理程序集） -->
    <ProjectReference Include="..\..\il2cppinterop\Il2CppInterop.RuntimeDetour\Il2CppInterop.RuntimeDetour.csproj" />

    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\..\interop\generated\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\..\..\..\interop\generated\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\..\interop\generated\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\..\..\interop\generated\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\..\..\..\interop\generated\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>..\..\..\..\interop\generated\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>..\..\..\..\interop\generated\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestWWWModule">
      <HintPath>..\..\..\..\interop\generated\UnityEngine.UnityWebRequestWWWModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 仓库内自带的 Il2CppInterop（已打 BepInEx-Android 的 ARM64/Disarm 补丁） -->
    <ProjectReference Include="..\..\il2cppinterop\Il2CppInterop.Runtime\Il2CppInterop.Runtime.csproj" />
    <ProjectReference Include="..\..\il2cppinterop\Il2CppInterop.Common\Il2CppInterop.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pylon.ImGui\Pylon.ImGui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Textures\loaderIcon.png" />
    <EmbeddedResource Include="Textures\pylon.png" />
    <!-- ImGui 字体随程序集内嵌，避免在安卓上依赖外部文件路径 -->
    <EmbeddedResource Include="ImGui\Fonts\ui.ttf">
      <LogicalName>Pylon.ModLoader.ImGui.Fonts.ui.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>