<Project>
  <!--
    托管层共享构建配置。

    可空引用类型 / 隐式 using / 分析器等级按工程逐个开启（写在各 csproj 里）：
    重构是一个工程一个工程推进的，未完成的工程保持旧设置，避免警告洪水淹没编译输出。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!--
      漏洞审计告警（NU1900）不升级为错误：本机/CI 常常离线，连不上 nuget.org 时
      它只是一条"拿不到审计数据"的提示，不该阻断编译。在线时警告照常显示。
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
