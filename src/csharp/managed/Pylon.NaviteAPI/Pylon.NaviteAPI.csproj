<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Pylon.NaviteAPI</AssemblyName>
    <RootNamespace>Pylon.NaviteAPI</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 本工程已零警告：任何新警告都当作错误，防止回潮 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 绑定保持 internal：宿主与框架直接调，Mod 作者走 Pylon.ModLoader 的托管包装 -->
    <InternalsVisibleTo Include="Pylon.ModLoader" />
    <InternalsVisibleTo Include="Pylon.Managed" />
  </ItemGroup>
</Project>
