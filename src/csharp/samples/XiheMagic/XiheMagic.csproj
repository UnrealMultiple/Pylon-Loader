<Project Sdk="Microsoft.NET.Sdk">
  <!--
    羲和魔杖（MEAC 的 XiHeMagicItem 复刻）：物品 + 引导控制器 + 天降激光柱。
    激光柱主体走 Pylon 的屏幕效果着色器（assets/effects/XiheBeam.frag）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XiheMagic</AssemblyName>
    <RootNamespace>XiheMagic</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0436</NoWarn>
    <!-- 单引用 Mod：游戏代理 + ImGui + Abstractions + Il2CppInterop 全部由这一个引用带入 -->
    <PylonModProject>true</PylonModProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一引用：游戏代理（Assembly-CSharp/Il2Cppmscorlib/UnityEngine.*）由仓库根 Directory.Build.targets 注入 -->
    <ProjectReference Include="..\..\managed\Pylon.ModLoader\Pylon.ModLoader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>