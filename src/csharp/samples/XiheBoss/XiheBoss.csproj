<Project Sdk="Microsoft.NET.Sdk">
  <!--
    羲和 Boss（MEAC.Bosses.EoL.XiHe 的 1:1 复刻）：NPC 本体 + 9 种弹幕 + VisualEffect 组 + 屏幕着色器。
    所有发光/光束/环/太阳/天空/灰度/径向模糊都走 Pylon 的屏幕效果管线（assets/effects/*.frag）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XiheBoss</AssemblyName>
    <RootNamespace>XiheBoss</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0436</NoWarn>
    <!-- 单引用 Mod：游戏代理 + ImGui + Abstractions + Il2CppInterop 全部由这一个引用带入 -->
    <PylonModProject>true</PylonModProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一引用：游戏代理（Assembly-CSharp/Il2Cppmscorlib/UnityEngine.*）由仓库根 Directory.Build.targets 注入 -->
    <ProjectReference Include="..\..\managed\Pylon.ModLoader\Pylon.ModLoader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>