<Project Sdk="Microsoft.NET.Sdk">
  <!--
    示例 Mod（框架式）：派生 Pylon.ModLoader.Mod，用 ModItem 声明两件自定义物品。
    自研项目之间统一 ProjectReference（构建脚本带 -m:1 -p:RestoreUseStaticGraphEvaluation=true，
    规避本机 SDK 缺 Workload 定位目录导致的多工程还原静默失败）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FrameMod</AssemblyName>
    <RootNamespace>FrameMod</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0436</NoWarn>
    <!-- 单引用 Mod：游戏代理 + ImGui + Abstractions + Il2CppInterop 全部由这一个引用带入 -->
    <PylonModProject>true</PylonModProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一引用：框架 + ImGui + Abstractions + Il2CppInterop 由 ProjectReference 传递引用带入，
         游戏代理（Assembly-CSharp/Il2Cppmscorlib/UnityEngine.*）由仓库根 Directory.Build.targets 注入 -->
    <ProjectReference Include="..\..\managed\Pylon.ModLoader\Pylon.ModLoader.csproj" />
  </ItemGroup>

  <!-- 瘦身为着色器测试：排除全部内容/自检/音乐文件（否则会被自动发现并安装，还会触发 MIUI 冻结） -->
  <ItemGroup>
    <Compile Remove="FrameConfig.cs" />
    <Compile Remove="FrameImGuiTab.cs" />
    <Compile Remove="FrameSelfTest.cs" />
    <Compile Remove="GlobalTestBuff.cs" />
    <Compile Remove="GlobalTestItem.cs" />
    <Compile Remove="GlobalTestNpc.cs" />
    <Compile Remove="GlobalTestProjectile.cs" />
    <Compile Remove="TestAccessoryPrefix.cs" />
    <Compile Remove="TestBuff.cs" />
    <Compile Remove="TestBuffPotion.cs" />
    <Compile Remove="TestFireball.cs" />
    <Compile Remove="TestFurniture.cs" />
    <Compile Remove="TestFurnitureItem.cs" />
    <Compile Remove="TestMaterial.cs" />
    <Compile Remove="TestMount.cs" />
    <Compile Remove="TestMountBuff.cs" />
    <Compile Remove="TestMountItem.cs" />
    <Compile Remove="TestNpc.cs" />
    <Compile Remove="TestPrefix.cs" />
    <Compile Remove="TestRarity.cs" />
    <Compile Remove="TestSceneEffect.cs" />
    <Compile Remove="TestSummonItem.cs" />
    <Compile Remove="TestSword.cs" />
    <Compile Remove="TestTile.cs" />
    <Compile Remove="TestTileItem.cs" />
    <Compile Remove="TestTownNpc.cs" />
    <Compile Remove="TestWall.cs" />
    <Compile Remove="TestWallItem.cs" />
  </ItemGroup>

</Project>