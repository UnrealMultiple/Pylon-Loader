<Project Sdk="Microsoft.NET.Sdk">
  <!-- 临时探针：注册一个 ModWaterStyle，触发 WaterPipeline 的 DrawWaters 上限补丁。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WaterProbe</AssemblyName>
    <RootNamespace>WaterProbe</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0436</NoWarn>
    <PylonModProject>true</PylonModProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\managed\Pylon.ModLoader\Pylon.ModLoader.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
