                android:startX="10.6"
                android:startY="3.5"
                android:endX="13.4"
                android:endY="6.3">
                <item android:offset="0" android:color="#FFBFF4FF" />
                <item android:offset="1" android:color="#FF9A8CFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
