constexpr double kPollIntervalSeconds = 0.10;
constexpr jint kInputTypeText = 0x00000001;
constexpr jint kInputTypeNoSuggestions = 0x00080000;
constexpr jint kImeActionDone = 0x00000006;
constexpr jint kImeFlagNoExtractUi = 0x10000000;
constexpr jint kShowForced = 2;
constexpr jint kViewVisible = 0;
constexpr jint kViewGone = 8;

// 看门狗阈值：连续多少次生命周期轮询（约 100ms 一次）里「桥接仍认为键盘开着
// （keyboardRequested==true），但系统 IME 已不再接受文本」就判定输入法被系统/输入法
// 自己收起了（关闭按钮、返回手势、游戏主动收起等），需要重置桥接状态。8 次约 800ms，
// 给键盘弹出/连接留足余量，避免误杀正在弹出的键盘。
constexpr int kImeDismissedPollThreshold = 8;

// 键盘展示的自愈重试参数。隐藏 EditText 窗口是异步 addView 的，第一次 showSoftInput 常常
// 发生在窗口尚未 attach/可聚焦之前而静默失败（导致「要点击两次才能唤醒键盘」——旧逻辑把
// 重试挂在「下一次触摸」上，用户只能再点一次）。现在改为：展示未确认成功时，在 UI 线程上
// 用 Handler 延迟自动重试，直到系统 IME 确认接收文本或尝试次数用尽，全程不需要第二次触摸。
constexpr int64_t kShowRetryDelayMs = 100;   // 两次展示尝试之间的延迟
constexpr int kMaxShowAttempts = 8;          // 单次请求的最大展示尝试次数（含首次）

// 键盘会话的「最近活跃」刷新窗口：会话开始（RequestShowKeyboard / 首次检测到 IME 接受文本）
// 后的这段时间内，UpdateKeyboardActivity 会持续刷新键盘活跃时间戳（喂给 ImGuiHost 的
// 1500ms 重建守卫）。超过该窗口后停止刷新，让守卫自然过期、surface 健康检查恢复正常运行，
// 避免长时间打字期间守卫永不过期、真实的 surface 故障（如 IME 引发的父 Surface 变化）
// 被无限期压制。
constexpr int64_t kKbSessionGuardMs = 5000;

enum class UiTaskType
{
    ShowKeyboard,
    HideKeyboard,
    PollText,
    SetText,
    VerifyShow,   // 延迟校验并（必要时）重试键盘展示
};

struct UiTask
{
    UiTaskType type;
    std::string text;
    bool syncText = false;
    std::uint64_t requestEpoch = 0;
};

