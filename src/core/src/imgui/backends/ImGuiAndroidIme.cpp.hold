// Persistent, per-widget buffers for InputInt/InputFloat. ImGui's InputText needs a user buffer
// that keeps a stable address across frames. A per-frame stack buffer becomes a stale pointer
// once the IME reloads the input state (e.g. typing non-numeric text into a numeric field),
// which crashes with a null/trash deref. Keyed by ImGuiID (already window/ID-stack scoped).
// Use std::map (node-based) so inserting new fields never moves existing buffers; std::unordered_map
// would rehash and invalidate the addresses ImGui holds.
std::map<ImGuiID, std::array<char, 64>> g_scalarBuffers;

void NativeRun(JNIEnv* env, jclass, jlong taskPtr);
void NativeTextChanged(JNIEnv* env, jclass, jstring text);
void NativeDeleteBackward(JNIEnv* env, jclass, jint count);

JNIEnv* GetEnv(bool& needDetach)
{
    needDetach = false;
    JavaVM* vm = AndroidPlatform::GetJavaVM();
    if (!vm)
        return nullptr;

    JNIEnv* env = nullptr;
    if (vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) == JNI_OK)
        return env;

    if (vm->AttachCurrentThread(&env, nullptr) != JNI_OK)
        return nullptr;

    needDetach = true;
    return env;
}

void DetachEnv(bool needDetach)
{
    if (!needDetach)
        return;

    JavaVM* vm = AndroidPlatform::GetJavaVM();
    if (vm)
        vm->DetachCurrentThread();
}

bool ClearException(JNIEnv* env)
{
    if (!env || !env->ExceptionCheck())
        return false;
    env->ExceptionClear();
    return true;
}

void UpdateSharedText(const std::string& text)
{
    std::lock_guard<std::mutex> lock(textMutex);
    sharedText = text;
}

std::string ReadSharedText()
{
    std::lock_guard<std::mutex> lock(textMutex);
    return sharedText;
}

bool CopyTextToBuffer(const std::string& text, char* buffer, size_t bufferSize)
{
    if (!buffer || bufferSize == 0)
        return false;

    if (std::strncmp(buffer, text.c_str(), bufferSize) == 0)
        return false;

    size_t copyLen = std::min(bufferSize - 1, text.size());
    std::memcpy(buffer, text.data(), copyLen);
    buffer[copyLen] = '\0';
    return true;
}

void ReloadActiveInputState(ImGuiID id)
{
    ImGuiInputTextState* state = ImGui::GetInputTextState(id);
    if (!state)
        return;

    state->ReloadUserBufAndMoveToEnd();
    state->Scroll.x = 0.0f;
    state->CursorFollow = true;
    state->CursorAnimReset();
}

void EraseLastUtf8Codepoint(std::string& text)
{
    if (text.empty())
        return;

    size_t pos = text.size() - 1;
    while (pos > 0 && (static_cast<unsigned char>(text[pos]) & 0xC0) == 0x80)
        --pos;
    text.erase(pos);
}

std::string JavaStringToStdString(JNIEnv* env, jstring value)
{
    if (!env || !value)
        return {};

    const char* chars = env->GetStringUTFChars(value, nullptr);
    if (!chars)
        return {};

    std::string result(chars);
    env->ReleaseStringUTFChars(value, chars);
    return result;
}

std::string GetFileAbsolutePath(JNIEnv* env, jobject file)
{
    if (!env || !file)
        return {};

    jclass fileClass = env->GetObjectClass(file);
    jmethodID getAbsolutePath = fileClass ? env->GetMethodID(fileClass, "getAbsolutePath", "()Ljava/lang/String;") : nullptr;
    jstring path = (getAbsolutePath && !ClearException(env))
        ? static_cast<jstring>(env->CallObjectMethod(file, getAbsolutePath)) : nullptr;
    ClearException(env);

    std::string result = JavaStringToStdString(env, path);
    if (path)
        env->DeleteLocalRef(path);
    if (fileClass)
        env->DeleteLocalRef(fileClass);
    return result;
}

std::string GetCacheDirPath(JNIEnv* env, jobject activity)
{
    if (!env || !activity)
        return {};

    jclass activityClass = env->GetObjectClass(activity);
    jmethodID getCodeCacheDir = activityClass ? env->GetMethodID(activityClass, "getCodeCacheDir", "()Ljava/io/File;") : nullptr;
    jobject cacheDir = (getCodeCacheDir && !ClearException(env))
        ? env->CallObjectMethod(activity, getCodeCacheDir) : nullptr;
    ClearException(env);

    if (!cacheDir)
    {
        jmethodID getCacheDir = activityClass ? env->GetMethodID(activityClass, "getCacheDir", "()Ljava/io/File;") : nullptr;
        cacheDir = (getCacheDir && !ClearException(env))
            ? env->CallObjectMethod(activity, getCacheDir) : nullptr;
        ClearException(env);
    }

    std::string result = GetFileAbsolutePath(env, cacheDir);
    if (cacheDir)
        env->DeleteLocalRef(cacheDir);
    if (activityClass)
        env->DeleteLocalRef(activityClass);
    return result;
}

bool WriteBridgeDex(const std::string& cacheDirPath, std::string& outDexPath)
{
    if (cacheDirPath.empty())
        return false;

    outDexPath = cacheDirPath + "/andhook_ime_bridge.dex";
    std::remove(outDexPath.c_str());

    std::ofstream file(outDexPath, std::ios::binary | std::ios::trunc);
    if (!file)
        return false;

    file.write(reinterpret_cast<const char*>(kImeBridgeDex), static_cast<std::streamsize>(kImeBridgeDexSize));
    file.close();
    if (!file.good())
        return false;

    chmod(outDexPath.c_str(), 0444);
    return true;
}

bool EnsureRunnableBridgeLocked(JNIEnv* env, jobject activity)
{
    if (runnableClass && runnableCtor)
        return true;
    if (bridgeFailed || !env || !activity)
        return false;

    std::string cacheDirPath = GetCacheDirPath(env, activity);
    std::string dexPath;
    if (!WriteBridgeDex(cacheDirPath, dexPath))
    {
        bridgeFailed = true;
        LOGE("[ImGuiAndroidIme] failed to write bridge dex");
        return false;
    }

    jclass activityClass = env->GetObjectClass(activity);
    jmethodID getClassLoader = activityClass ? env->GetMethodID(
        activityClass, "getClassLoader", "()Ljava/lang/ClassLoader;") : nullptr;
    jobject parentLoader = (getClassLoader && !ClearException(env))
        ? env->CallObjectMethod(activity, getClassLoader) : nullptr;
    ClearException(env);
    if (activityClass)
        env->DeleteLocalRef(activityClass);
    if (!parentLoader)
    {
        bridgeFailed = true;
        return false;
    }

    jclass dexLoaderClass = env->FindClass("dalvik/system/DexClassLoader");
    jmethodID dexLoaderCtor = dexLoaderClass ? env->GetMethodID(
        dexLoaderClass, "<init>",
        "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/ClassLoader;)V") : nullptr;
    jstring dexPathString = env->NewStringUTF(dexPath.c_str());
    jstring optDirString = env->NewStringUTF(cacheDirPath.c_str());
    jobject dexLoader = (dexLoaderCtor && dexPathString && optDirString && !ClearException(env))
        ? env->NewObject(dexLoaderClass, dexLoaderCtor, dexPathString, optDirString, nullptr, parentLoader) : nullptr;
    ClearException(env);

    jclass classLoaderClass = env->FindClass("java/lang/ClassLoader");
    jmethodID loadClass = classLoaderClass ? env->GetMethodID(classLoaderClass, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;") : nullptr;
    jstring className = env->NewStringUTF("com.andhook.ImeBridgeRunnable");
    jclass localClass = (dexLoader && loadClass && className && !ClearException(env))
        ? static_cast<jclass>(env->CallObjectMethod(dexLoader, loadClass, className)) : nullptr;
    ClearException(env);
    jstring watcherClassName = env->NewStringUTF("com.andhook.ImeBridgeTextWatcher");
    jclass localWatcherClass = (dexLoader && loadClass && watcherClassName && !ClearException(env))
        ? static_cast<jclass>(env->CallObjectMethod(dexLoader, loadClass, watcherClassName)) : nullptr;
    ClearException(env);
    jstring editTextClassName = env->NewStringUTF("com.andhook.ImeBridgeEditText");
    jclass localEditTextClass = (dexLoader && loadClass && editTextClassName && !ClearException(env))
        ? static_cast<jclass>(env->CallObjectMethod(dexLoader, loadClass, editTextClassName)) : nullptr;
    ClearException(env);
    jstring inputConnectionClassName = env->NewStringUTF("com.andhook.ImeBridgeInputConnection");
    jclass localInputConnectionClass = (dexLoader && loadClass && inputConnectionClassName && !ClearException(env))
        ? static_cast<jclass>(env->CallObjectMethod(dexLoader, loadClass, inputConnectionClassName)) : nullptr;
    ClearException(env);

    if (localClass)
    {
        JNINativeMethod methods[] = {
            {const_cast<char*>("nativeRun"), const_cast<char*>("(J)V"), reinterpret_cast<void*>(&NativeRun)},
        };
        if (env->RegisterNatives(localClass, methods, 1) != JNI_OK || ClearException(env))
            localClass = nullptr;
    }

    if (localClass)
    {
        runnableClass = static_cast<jclass>(env->NewGlobalRef(localClass));
        runnableCtor = env->GetMethodID(runnableClass, "<init>", "(J)V");
        if (!runnableClass || !runnableCtor || ClearException(env))
        {
            if (runnableClass)
                env->DeleteGlobalRef(runnableClass);
            runnableClass = nullptr;
            runnableCtor = nullptr;
        }
    }

    if (localWatcherClass)
    {
        JNINativeMethod methods[] = {
            {const_cast<char*>("nativeTextChanged"), const_cast<char*>("(Ljava/lang/String;)V"), reinterpret_cast<void*>(&NativeTextChanged)},
        };
        if (env->RegisterNatives(localWatcherClass, methods, 1) != JNI_OK || ClearException(env))
            localWatcherClass = nullptr;
    }

    if (localWatcherClass)
    {
        textWatcherClass = static_cast<jclass>(env->NewGlobalRef(localWatcherClass));
        textWatcherCtor = env->GetMethodID(textWatcherClass, "<init>", "()V");
        if (!textWatcherClass || !textWatcherCtor || ClearException(env))
        {
            if (textWatcherClass)
                env->DeleteGlobalRef(textWatcherClass);
            textWatcherClass = nullptr;
            textWatcherCtor = nullptr;
        }
    }

    if (localInputConnectionClass)
    {
        JNINativeMethod methods[] = {
            {const_cast<char*>("nativeDeleteBackward"), const_cast<char*>("(I)V"), reinterpret_cast<void*>(&NativeDeleteBackward)},
            {const_cast<char*>("nativeTextChanged"), const_cast<char*>("(Ljava/lang/String;)V"), reinterpret_cast<void*>(&NativeTextChanged)},
        };
        if (env->RegisterNatives(localInputConnectionClass, methods, 2) != JNI_OK || ClearException(env))
            localInputConnectionClass = nullptr;
    }

    if (localEditTextClass)
    {
        editTextClass = static_cast<jclass>(env->NewGlobalRef(localEditTextClass));
        editTextCtor = env->GetMethodID(editTextClass, "<init>", "(Landroid/content/Context;)V");
        if (!editTextClass || !editTextCtor || ClearException(env))
        {
            if (editTextClass)
                env->DeleteGlobalRef(editTextClass);
            editTextClass = nullptr;
            editTextCtor = nullptr;
        }
    }

    if (inputConnectionClassName)
        env->DeleteLocalRef(inputConnectionClassName);
    if (localInputConnectionClass)
        env->DeleteLocalRef(localInputConnectionClass);
    if (editTextClassName)
        env->DeleteLocalRef(editTextClassName);
    if (localEditTextClass)
        env->DeleteLocalRef(localEditTextClass);
    if (watcherClassName)
        env->DeleteLocalRef(watcherClassName);
    if (localWatcherClass)
        env->DeleteLocalRef(localWatcherClass);
    if (className)
        env->DeleteLocalRef(className);
    if (localClass)
        env->DeleteLocalRef(localClass);
    if (classLoaderClass)
        env->DeleteLocalRef(classLoaderClass);
    if (dexLoader)
        env->DeleteLocalRef(dexLoader);
    if (optDirString)
        env->DeleteLocalRef(optDirString);
    if (dexPathString)
        env->DeleteLocalRef(dexPathString);
    if (dexLoaderClass)
        env->DeleteLocalRef(dexLoaderClass);
    env->DeleteLocalRef(parentLoader);

    if (!runnableClass || !runnableCtor || !textWatcherClass || !textWatcherCtor ||
        !editTextClass || !editTextCtor)
    {
        bridgeFailed = true;
        LOGE("[ImGuiAndroidIme] failed to load bridge runnable");
        return false;
    }

    return true;
}

// 把 runnable 投递到主线程 Handler 的消息队列（delayMs==0 时等效 post）。无论调用线程是否
// 就是主线程，都一律走 Handler，保证任务绝不会在调用栈内联执行——这一点至关重要：触摸分发
// 回调（TouchBridgeView.onTouchEvent → NativeOnTouch，运行在 UI 线程）里如果同步执行任何
// IME/JNI/layout 工作，UI 线程就会被阻塞。阻塞期间游戏照常渲染（渲染在单独线程），但整个
// 界面的触摸输入全部排队失效，表现就是「界面没卡死、但摸不动」。runOnUiThread 在主线程上
// 调用会内联同步执行，因此这里统一改用 Handler.post/postDelayed。
bool PostRunnableToMainLooper(JNIEnv* env, jobject runnable, int64_t delayMs)
{
    if (!env || !runnable)
        return false;

    jclass looperClass = env->FindClass("android/os/Looper");
    jmethodID getMainLooper = looperClass
        ? env->GetStaticMethodID(looperClass, "getMainLooper", "()Landroid/os/Looper;")
        : nullptr;
    jobject mainLooper = (getMainLooper && !ClearException(env))
        ? env->CallStaticObjectMethod(looperClass, getMainLooper)
        : nullptr;
    ClearException(env);

    jclass handlerClass = env->FindClass("android/os/Handler");
    jmethodID handlerCtor = handlerClass
        ? env->GetMethodID(handlerClass, "<init>", "(Landroid/os/Looper;)V")
        : nullptr;
    jobject handler = (handlerCtor && mainLooper && !ClearException(env))
        ? env->NewObject(handlerClass, handlerCtor, mainLooper)
        : nullptr;
    ClearException(env);

    bool ok = false;
    if (delayMs > 0)
    {
        jmethodID postDelayed = handlerClass
            ? env->GetMethodID(handlerClass, "postDelayed", "(Ljava/lang/Runnable;J)Z")
            : nullptr;
        if (handler && postDelayed && !ClearException(env))
        {
            env->CallBooleanMethod(handler, postDelayed, runnable, static_cast<jlong>(delayMs));
            ok = !ClearException(env);
        }
        else
        {
            ClearException(env);
        }
    }
    else
    {
        jmethodID post = handlerClass
            ? env->GetMethodID(handlerClass, "post", "(Ljava/lang/Runnable;)Z")
            : nullptr;
        if (handler && post && !ClearException(env))
        {
            env->CallBooleanMethod(handler, post, runnable);
            ok = !ClearException(env);
        }
        else
        {
            ClearException(env);
        }
    }

    if (handler)
        env->DeleteLocalRef(handler);
    if (handlerClass)
        env->DeleteLocalRef(handlerClass);
    if (mainLooper)
        env->DeleteLocalRef(mainLooper);
    if (looperClass)
        env->DeleteLocalRef(looperClass);
    return ok;
}

bool PostUiTask(UiTask* task)
{
    if (!task)
        return false;

    bool needDetach = false;
    JNIEnv* env = GetEnv(needDetach);
    if (!env)
    {
        LOGE("[ImGuiAndroidIme] cannot post UI task: JNIEnv unavailable");
        delete task;
        return false;
    }

    jobject activity = AndroidPlatform::GetActivity();
    bool ok = false;
    if (activity)
    {
        std::lock_guard<std::mutex> lock(bridgeMutex);
        ok = EnsureRunnableBridgeLocked(env, activity);
    }
    else
        LOGE("[ImGuiAndroidIme] cannot post UI task: Activity unavailable");

    if (ok)
    {
        jobject runnable = env->NewObject(runnableClass, runnableCtor,
            static_cast<jlong>(reinterpret_cast<intptr_t>(task)));
        ClearException(env);
        ok = runnable && PostRunnableToMainLooper(env, runnable, 0);
        if (runnable)
            env->DeleteLocalRef(runnable);
    }

    DetachEnv(needDetach);

    if (!ok)
        delete task;
    return ok;
}

// 延时投递一个 UI 任务到主线程（用于键盘展示的自愈重试：第一次 showSoftInput 往往发生在
// 隐藏 EditText 窗口异步 addView 完成之前而失败，需要在 UI 线程上用 Handler 延迟重试，
// 而不是依赖「下一次触摸」）。任务执行时由 NativeRun 释放 UiTask。
bool PostUiTaskDelayed(UiTask* task, int64_t delayMs)
{
    if (!task)
        return false;

    bool needDetach = false;
    JNIEnv* env = GetEnv(needDetach);
    if (!env)
    {
        delete task;
        return false;
    }

    jobject activity = AndroidPlatform::GetActivity();
    bool ok = false;
    if (activity)
    {
        std::lock_guard<std::mutex> lock(bridgeMutex);
        ok = EnsureRunnableBridgeLocked(env, activity);
    }
    else
        LOGE("[ImGuiAndroidIme] cannot post delayed UI task: Activity unavailable");

    if (ok)
    {
        jobject runnable = env->NewObject(runnableClass, runnableCtor,
            static_cast<jlong>(reinterpret_cast<intptr_t>(task)));
        ClearException(env);
        ok = runnable && PostRunnableToMainLooper(env, runnable, delayMs);
        if (runnable)
            env->DeleteLocalRef(runnable);
    }

    DetachEnv(needDetach);

    if (!ok)
        delete task;
    return ok;
}

void SetViewBool(JNIEnv* env, jobject view, const char* methodName, bool value)
{
    jclass viewClass = env->GetObjectClass(view);
    jmethodID method = viewClass ? env->GetMethodID(viewClass, methodName, "(Z)V") : nullptr;
    if (method && !ClearException(env))
        env->CallVoidMethod(view, method, value ? JNI_TRUE : JNI_FALSE);
    ClearException(env);
    if (viewClass)
        env->DeleteLocalRef(viewClass);
}

void SetViewInt(JNIEnv* env, jobject view, const char* methodName, jint value)
{
    jclass viewClass = env->GetObjectClass(view);
    jmethodID method = viewClass ? env->GetMethodID(viewClass, methodName, "(I)V") : nullptr;
    if (method && !ClearException(env))
        env->CallVoidMethod(view, method, value);
    ClearException(env);
    if (viewClass)
        env->DeleteLocalRef(viewClass);
}

void SetViewFloat(JNIEnv* env, jobject view, const char* methodName, jfloat value)
{
    jclass viewClass = env->GetObjectClass(view);
    jmethodID method = viewClass ? env->GetMethodID(viewClass, methodName, "(F)V") : nullptr;
    if (method && !ClearException(env))
    {
        jvalue args[1]{};
        args[0].f = value;
        env->CallVoidMethodA(view, method, args);
    }
    ClearException(env);
    if (viewClass)
        env->DeleteLocalRef(viewClass);
}

jobject CreateLayoutParams(JNIEnv* env)
{
    jclass lpClass = env->FindClass("android/widget/FrameLayout$LayoutParams");
    jmethodID ctor = lpClass ? env->GetMethodID(lpClass, "<init>", "(II)V") : nullptr;
    jobject lp = (ctor && !ClearException(env)) ? env->NewObject(lpClass, ctor, 1, 1) : nullptr;
    ClearException(env);
    if (lpClass)
        env->DeleteLocalRef(lpClass);

    if (lp)
        return lp;

    lpClass = env->FindClass("android/view/ViewGroup$LayoutParams");
    ctor = lpClass ? env->GetMethodID(lpClass, "<init>", "(II)V") : nullptr;
    lp = (ctor && !ClearException(env)) ? env->NewObject(lpClass, ctor, 1, 1) : nullptr;
    ClearException(env);
    if (lpClass)
        env->DeleteLocalRef(lpClass);
    return lp;
}

// Create WindowManager.LayoutParams (width, height, type, flags, format).
// defaults: 1x1, TYPE_APPLICATION, FLAG_NOT_TOUCHABLE (focusable is toggled on show).
constexpr jint kFlagsNotTouchable = 0x10;
constexpr jint kFlagsNotFocusable = 0x08;

jobject CreateWmLayoutParams(JNIEnv* env, jint flags)
{    jclass pc = env->FindClass("android/view/WindowManager$LayoutParams");
    jmethodID ctor = pc ? env->GetMethodID(pc, "<init>", "(IIIII)V") : nullptr;
    jobject p = (ctor && !ClearException(env))
        ? env->NewObject(pc, ctor, 1, 1, 2 /*TYPE_APPLICATION*/, flags, -3 /*TRANSLUCENT*/)
        : nullptr;
    ClearException(env);
    if (pc)
        env->DeleteLocalRef(pc);
    return p;
}

// Forward declaration (defined later in the file).
jobject GetSystemService(JNIEnv* env, jobject activity, const char* name);

jobject GetWindowManager(JNIEnv* env, jobject activity)
{
    return GetSystemService(env, activity, "window");
}

// Set only the flags field on a WindowManager.LayoutParams (used before addView).
bool SetWmFlags(JNIEnv* env, jobject params, jint flags)
{
    if (!env || !params)
        return false;
    jclass pc = env->GetObjectClass(params);
    jfieldID flagsField = pc ? env->GetFieldID(pc, "flags", "I") : nullptr;
    if (flagsField && !ClearException(env))
        env->SetIntField(params, flagsField, flags);
    const bool ok = !ClearException(env);
    if (pc) env->DeleteLocalRef(pc);
    return ok;
}

// Update the flags field on an existing WindowManager.LayoutParams and re-apply it.
bool UpdateWmFlags(JNIEnv* env, jobject params, jobject windowManager,
                   jobject view, jint flags)
{
    if (!env || !params || !windowManager || !view)
        return false;
    jclass pc = env->GetObjectClass(params);
    jfieldID flagsField = pc ? env->GetFieldID(pc, "flags", "I") : nullptr;
    if (flagsField && !ClearException(env))
    {
        env->SetIntField(params, flagsField, flags);
        ClearException(env);
    }
    jclass wmc = env->GetObjectClass(windowManager);
    jmethodID updateViewLayout = wmc ? env->GetMethodID(
        wmc, "updateViewLayout",
        "(Landroid/view/View;Landroid/view/ViewGroup$LayoutParams;)V") : nullptr;
    if (updateViewLayout && !ClearException(env))
        env->CallVoidMethod(windowManager, updateViewLayout, view, params);
    const bool ok = !ClearException(env);
    if (pc) env->DeleteLocalRef(pc);
    if (wmc) env->DeleteLocalRef(wmc);
    return ok;
}

bool AttachEditTextWindow(JNIEnv* env)
{
    if (wmAdded || !editText || !windowManager || !wmParams)
        return wmAdded;
    jclass wmc = env->GetObjectClass(windowManager);
    jmethodID addView = wmc ? env->GetMethodID(
        wmc, "addView", "(Landroid/view/View;Landroid/view/ViewGroup$LayoutParams;)V") : nullptr;
    if (addView && !ClearException(env))
        env->CallVoidMethod(windowManager, addView, editText, wmParams);
    wmAdded = !ClearException(env);
    if (wmc) env->DeleteLocalRef(wmc);
    return wmAdded;
}

bool DetachEditTextWindow(JNIEnv* env)
{
    if (!wmAdded || !editText || !windowManager)
        return true;
    jclass wmc = env->GetObjectClass(windowManager);
    jmethodID removeView = wmc ? env->GetMethodID(
        wmc, "removeView", "(Landroid/view/View;)V") : nullptr;
    if (removeView && !ClearException(env))
        env->CallVoidMethod(windowManager, removeView, editText);
    ClearException(env);
    if (wmc) env->DeleteLocalRef(wmc);
    wmAdded = false;
    return true;
}

bool EnsureEditTextOnUiThread(JNIEnv* env, jobject activity)
{
    if (editText)
        return true;
    if (!env || !activity)
        return false;

    jclass bridgeEditTextClass = editTextClass;
    jobject localEditText = (bridgeEditTextClass && editTextCtor && !ClearException(env))
        ? env->NewObject(bridgeEditTextClass, editTextCtor, activity) : nullptr;
    if (!localEditText || ClearException(env))
        return false;

    SetViewBool(env, localEditText, "setFocusable", true);
    SetViewBool(env, localEditText, "setFocusableInTouchMode", true);
    SetViewBool(env, localEditText, "setSingleLine", true);
    SetViewBool(env, localEditText, "setSelectAllOnFocus", false);
    SetViewBool(env, localEditText, "setShowSoftInputOnFocus", false);
    SetViewBool(env, localEditText, "setLongClickable", false);
    SetViewBool(env, localEditText, "setTextIsSelectable", false);
    SetViewBool(env, localEditText, "setClickable", false);
    SetViewBool(env, localEditText, "setHapticFeedbackEnabled", false);
    SetViewBool(env, localEditText, "setCursorVisible", false);
    SetViewInt(env, localEditText, "setTextColor", 0x00000000);
    SetViewInt(env, localEditText, "setHintTextColor", 0x00000000);
    SetViewInt(env, localEditText, "setBackgroundColor", 0x00000000);
    SetViewFloat(env, localEditText, "setAlpha", 0.01f);

    jmethodID setInputType = bridgeEditTextClass ? env->GetMethodID(bridgeEditTextClass, "setInputType", "(I)V") : nullptr;
    if (setInputType && !ClearException(env))
        env->CallVoidMethod(localEditText, setInputType, kInputTypeText | kInputTypeNoSuggestions);
    ClearException(env);

    jmethodID setImeOptions = bridgeEditTextClass ? env->GetMethodID(bridgeEditTextClass, "setImeOptions", "(I)V") : nullptr;
    if (setImeOptions && !ClearException(env))
        env->CallVoidMethod(localEditText, setImeOptions, kImeActionDone | kImeFlagNoExtractUi);
    ClearException(env);

    if (textWatcherClass && textWatcherCtor)
    {
        jobject watcher = env->NewObject(textWatcherClass, textWatcherCtor);
        ClearException(env);
        jmethodID addTextChangedListener = bridgeEditTextClass ? env->GetMethodID(
            bridgeEditTextClass, "addTextChangedListener", "(Landroid/text/TextWatcher;)V") : nullptr;
        if (watcher && addTextChangedListener && !ClearException(env))
            env->CallVoidMethod(localEditText, addTextChangedListener, watcher);
        ClearException(env);

        if (watcher)
        {
            textWatcher = env->NewGlobalRef(watcher);
            env->DeleteLocalRef(watcher);
        }
    }

    // Build the hidden EditText window: instead of hiding inside the game Activity's
    // content view (which the game window won't give IME focus), we attach it as a tiny
    // top-level WindowManager window. It is never touchable (so it doesn't block the touch
    // bridge) and only becomes focusable while the keyboard is shown.
    wmParams = CreateWmLayoutParams(env, kFlagsNotTouchable | kFlagsNotFocusable);
    windowManager = GetWindowManager(env, activity);
    if (!wmParams || !windowManager || ClearException(env))
    {
        if (wmParams) env->DeleteLocalRef(wmParams);
        if (windowManager) env->DeleteLocalRef(windowManager);
        wmParams = nullptr;
        windowManager = nullptr;
        env->DeleteLocalRef(localEditText);
        return false;
    }
    wmParams = env->NewGlobalRef(wmParams);
    windowManager = env->NewGlobalRef(windowManager);

    editText = env->NewGlobalRef(localEditText);
    SetViewBool(env, localEditText, "setEnabled", false);
    SetViewInt(env, localEditText, "setVisibility", kViewGone);
    SetWmFlags(env, wmParams, kFlagsNotTouchable | kFlagsNotFocusable);

    // Attach the EditText window ONCE and keep it attached. Visibility + focusability are
    // toggled on show/hide, so we never churn addView/removeView (a crash source when the
    // window/focus state is unstable, e.g. closing the keyboard then tapping).
    AttachEditTextWindow(env);

    env->DeleteLocalRef(localEditText);
    return editText != nullptr;
}

void SetEditTextString(JNIEnv* env, const std::string& text)
{
    if (!editText)
        return;

    jstring jtext = env->NewStringUTF(text.c_str());
    if (!jtext || ClearException(env))
        return;

    jclass editTextClass = env->GetObjectClass(editText);
    jmethodID setText = editTextClass ? env->GetMethodID(
        editTextClass, "setText", "(Ljava/lang/CharSequence;)V") : nullptr;
    if (setText && !ClearException(env))
        env->CallVoidMethod(editText, setText, jtext);
    ClearException(env);

    jmethodID setSelection = editTextClass ? env->GetMethodID(editTextClass, "setSelection", "(I)V") : nullptr;
    if (setSelection && !ClearException(env))
        env->CallVoidMethod(editText, setSelection, env->GetStringLength(jtext));
    ClearException(env);

    if (editTextClass)
        env->DeleteLocalRef(editTextClass);
    env->DeleteLocalRef(jtext);
}

void NativeDeleteBackward(JNIEnv* env, jclass, jint count)
{
    std::string text = ReadSharedText();
    int eraseCount = std::max(1, static_cast<int>(count));
    while (eraseCount-- > 0 && !text.empty())
        EraseLastUtf8Codepoint(text);

    UpdateSharedText(text);
    SetEditTextString(env, text);
}

std::string GetEditTextString(JNIEnv* env)
{
    if (!editText)
        return {};

    jclass editTextClass = env->GetObjectClass(editText);
    jmethodID getText = editTextClass ? env->GetMethodID(editTextClass, "getText", "()Landroid/text/Editable;") : nullptr;
    jobject editable = (getText && !ClearException(env)) ? env->CallObjectMethod(editText, getText) : nullptr;
    ClearException(env);
    if (!editable)
    {
        if (editTextClass)
            env->DeleteLocalRef(editTextClass);
        return {};
    }

    jclass objectClass = env->FindClass("java/lang/Object");
    jmethodID toString = objectClass ? env->GetMethodID(objectClass, "toString", "()Ljava/lang/String;") : nullptr;
    jstring jtext = (toString && !ClearException(env)) ? static_cast<jstring>(env->CallObjectMethod(editable, toString)) : nullptr;
    ClearException(env);

    std::string result = JavaStringToStdString(env, jtext);
    if (jtext)
        env->DeleteLocalRef(jtext);
    if (objectClass)
        env->DeleteLocalRef(objectClass);
    env->DeleteLocalRef(editable);
    if (editTextClass)
        env->DeleteLocalRef(editTextClass);
    return result;
}

jobject GetSystemService(JNIEnv* env, jobject activity, const char* name)
{
    if (!env || !activity)
        return nullptr;

    jclass activityClass = env->GetObjectClass(activity);
    jmethodID getSystemService = activityClass ? env->GetMethodID(
        activityClass, "getSystemService", "(Ljava/lang/String;)Ljava/lang/Object;") : nullptr;
    jstring serviceName = env->NewStringUTF(name);
    jobject service = (getSystemService && serviceName && !ClearException(env))
        ? env->CallObjectMethod(activity, getSystemService, serviceName) : nullptr;
    ClearException(env);

    if (serviceName)
        env->DeleteLocalRef(serviceName);
    if (activityClass)
        env->DeleteLocalRef(activityClass);
    return service;
}

bool ImeIsAcceptingText(JNIEnv* env, jobject activity)
{
    // InputMethodManager.isAcceptingText() 返回 true 表示系统输入法正连接并服务着本应用的
    // 文本编辑视图（含隐藏 EditText）。用它来确认键盘是否真的弹出，从而决定自愈重试是否
    // 还需要继续。
    if (!env || !activity)
        return false;

    jobject imm = GetSystemService(env, activity, "input_method");
    if (!imm)
        return false;

    bool accepting = false;
    jclass immClass = env->GetObjectClass(imm);
    jmethodID isAcceptingText = immClass
        ? env->GetMethodID(immClass, "isAcceptingText", "()Z")
        : nullptr;
    if (isAcceptingText && !ClearException(env))
    {
        accepting = env->CallBooleanMethod(imm, isAcceptingText) == JNI_TRUE;
        ClearException(env);
    }
    ClearException(env);

    if (immClass)
        env->DeleteLocalRef(immClass);
    env->DeleteLocalRef(imm);
    return accepting;
}

bool EditTextHasWindowToken(JNIEnv* env)
{
    // 隐藏 EditText 窗口是异步 addView 的：addView 之后到窗口真正 attach（拿到 IBinder
    // window token）之间有一个遍历间隙。在这个间隙里 requestFocus()/showSoftInput() 必然
    // 失败。用「是否有 window token」作为窗口是否就绪的判断，就绪前不做无效展示。
    if (!env || !editText)
        return false;

    jclass viewClass = env->GetObjectClass(editText);
    jmethodID getWindowToken = viewClass
        ? env->GetMethodID(viewClass, "getWindowToken", "()Landroid/os/IBinder;")
        : nullptr;
    jobject token = (getWindowToken && !ClearException(env))
        ? env->CallObjectMethod(editText, getWindowToken)
        : nullptr;
    ClearException(env);

    if (token)
        env->DeleteLocalRef(token);
    if (viewClass)
        env->DeleteLocalRef(viewClass);
    return token != nullptr;
}

bool IsCurrentShowRequest(std::uint64_t requestEpoch)
{
    return keyboardRequested.load(std::memory_order_acquire) &&
           showRequestEpoch.load(std::memory_order_acquire) == requestEpoch;
}

void CancelShowRequests()
{
    std::lock_guard<std::mutex> lock(pendingShowMutex);
    keyboardRequested.store(false, std::memory_order_release);
    g_keyboardShown.store(false, std::memory_order_release);
    showRequestEpoch.fetch_add(1, std::memory_order_acq_rel);
    pendingShowText.clear();
    pendingShowSyncText = false;
    pendingShowEpoch = showRequestEpoch.load(std::memory_order_acquire);
    showTaskPending.store(false, std::memory_order_release);
    pollTaskPending.store(false, std::memory_order_release);
    g_KbSessionStartMs.store(0, std::memory_order_release);
    // 正在排队的延迟校验/重试任务会在开头用 IsCurrentShowRequest() 检查到 requestEpoch 已
    // 过期而自行退出，因此这里无需（也不应该）单独取消它们。
}

void ClearInputFieldRect()
{
    std::lock_guard<std::mutex> lock(inputFieldMutex);
    inputFieldRect = {};
}

void UpdateInputFieldRect(ImGuiID id, const ImVec2& minimum,
                          const ImVec2& maximum)
{
    std::lock_guard<std::mutex> lock(inputFieldMutex);
    inputFieldRect.id = id;
    inputFieldRect.minX = minimum.x;
    inputFieldRect.minY = minimum.y;
    inputFieldRect.maxX = maximum.x;
    inputFieldRect.maxY = maximum.y;
    inputFieldRect.valid = true;
}

bool IsInsideInputField(float x, float y)
{
    constexpr float touchPadding = 8.0f;
    std::lock_guard<std::mutex> lock(inputFieldMutex);
    return inputFieldRect.valid &&
           x >= inputFieldRect.minX - touchPadding &&
           x <= inputFieldRect.maxX + touchPadding &&
           y >= inputFieldRect.minY - touchPadding &&
           y <= inputFieldRect.maxY + touchPadding;
}

void ShowKeyboardOnUiThread(JNIEnv* env, jobject activity,
                            const std::string& text, bool syncText,
                            std::uint64_t requestEpoch)
{
    if (!IsCurrentShowRequest(requestEpoch))
    {
        showTaskPending.store(false, std::memory_order_release);
        return;
    }

    if (!EnsureEditTextOnUiThread(env, activity))
    {
        LOGE("[ImGuiAndroidIme] failed to create UI-thread EditText");
        showTaskPending.store(false, std::memory_order_release);
        return;
    }

    if (!IsCurrentShowRequest(requestEpoch))
    {
        showTaskPending.store(false, std::memory_order_release);
        return;
    }

    if (syncText)
    {
        SetEditTextString(env, text);
        UpdateSharedText(text);
    }

    // Make the hidden EditText window focusable (it stays attached; we only flip visibility
    // and focusability). The window is never touchable (FLAG_NOT_TOUCHABLE), so it does not
    // block the touch bridge; it becomes focusable here so the IME reliably connects to it.
    UpdateWmFlags(env, wmParams, windowManager, editText, kFlagsNotTouchable);

    SetViewInt(env, editText, "setVisibility", kViewVisible);
    SetViewBool(env, editText, "setEnabled", true);
    SetViewBool(env, editText, "setCursorVisible", false);

    // 只有窗口已经 attach（拿到 window token）才做 requestFocus/restartInput/showSoftInput。
    // 否则这些调用必然失败（且可能把 IMM 置入坏状态），直接跳过，交由末尾的自愈重试链在
    // 窗口 attach 完成后再展示。
    bool shown = false;
    if (EditTextHasWindowToken(env))
    {
        jclass editTextClass = env->GetObjectClass(editText);
        jmethodID requestFocus = editTextClass ? env->GetMethodID(editTextClass, "requestFocus", "()Z") : nullptr;
        if (requestFocus && !ClearException(env))
            env->CallBooleanMethod(editText, requestFocus);
        ClearException(env);

        jobject imm = GetSystemService(env, activity, "input_method");
        if (imm)
        {
            jclass immClass = env->GetObjectClass(imm);
            jmethodID restartInput = immClass ? env->GetMethodID(immClass, "restartInput", "(Landroid/view/View;)V") : nullptr;
            if (restartInput && !ClearException(env))
                env->CallVoidMethod(imm, restartInput, editText);
            ClearException(env);

            // showSoftInput 的返回值才是「展示请求是否被系统接受」的可靠信号（false 对应
            // ImeTracker 的 onFailed@CLIENT_VIEW_SERVED）。isAcceptingText() 不可靠：restartInput
            // 一旦建立输入连接（日志里的 SogouIME onStartInput）它就会返回 true，哪怕键盘窗口
            // 根本没弹出来。所以这里以返回值为准，失败则继续自愈重试。
            jmethodID showSoftInput = immClass ? env->GetMethodID(immClass, "showSoftInput", "(Landroid/view/View;I)Z") : nullptr;
            if (showSoftInput && !ClearException(env))
            {
                const jboolean ret = env->CallBooleanMethod(imm, showSoftInput, editText, kShowForced);
                const bool hadException = ClearException(env);
                shown = (ret == JNI_TRUE) && !hadException;
            }
            else
            {
                ClearException(env);
            }

            if (immClass)
                env->DeleteLocalRef(immClass);
            env->DeleteLocalRef(imm);
        }

        if (editTextClass)
            env->DeleteLocalRef(editTextClass);
    }
    else
    {
        LOGI("[ImGuiAndroidIme] EditText window not attached yet; deferring show");
    }

    if (shown)
        g_keyboardShown.store(true, std::memory_order_release);

    if (IsCurrentShowRequest(requestEpoch))
    {
        if (shown)
        {
            // 展示请求已被系统接受，键盘会（正在）弹出，无需再重试。
            LOGI("[ImGuiAndroidIme] showSoftInput accepted");
        }
        else if (g_showRetryAttempts.fetch_add(1, std::memory_order_acq_rel) + 1 <
                 kMaxShowAttempts)
        {
            PostUiTaskDelayed(
                new UiTask{UiTaskType::VerifyShow, {}, false, requestEpoch},
                kShowRetryDelayMs);
        }
        else
        {
            // 部分输入法（如部分版本搜狗）在键盘实际弹出时 showSoftInput 仍返回 false，
            // 导致 g_keyboardShown 永不置位、触摸路径反复重试。重试链耗尽后若系统 IME
            // 已建立输入连接（isAcceptingText），按「已弹出」收敛状态，停止无效重试。
            if (ImeIsAcceptingText(env, activity))
            {
                g_keyboardShown.store(true, std::memory_order_release);
                LOGI("[ImGuiAndroidIme] IME accepting text; keyboard considered shown");
            }
            else
            {
                LOGW("[ImGuiAndroidIme] show retries exhausted, keyboard did not appear");
            }
        }
    }
    showTaskPending.store(false, std::memory_order_release);
}

// VerifyShow 任务的 UI 线程主体：重做一次完整展示。成功与否由 ShowKeyboardOnUiThread 依据
// showSoftInput 的返回值决定（并决定是否继续安排下一次 VerifyShow）。
void VerifyShowKeyboardOnUiThread(JNIEnv* env, jobject activity,
                                  std::uint64_t requestEpoch)
{
    // 该请求已被取消/取代（用户点到了别处、发起了新请求等），延迟任务直接退出。
    if (!IsCurrentShowRequest(requestEpoch))
    {
        showTaskPending.store(false, std::memory_order_release);
        return;
    }

    ShowKeyboardOnUiThread(env, activity, "", false, requestEpoch);
}

void HideKeyboardOnUiThread(JNIEnv* env, jobject activity)
{
    if (editText && activity)
    {
        jobject imm = GetSystemService(env, activity, "input_method");
        jclass viewClass = env->GetObjectClass(editText);
        jmethodID getWindowToken = viewClass ? env->GetMethodID(
            viewClass, "getWindowToken", "()Landroid/os/IBinder;") : nullptr;
        jobject windowToken = (getWindowToken && !ClearException(env))
            ? env->CallObjectMethod(editText, getWindowToken) : nullptr;
        ClearException(env);

        if (imm && windowToken)
        {
            jclass immClass = env->GetObjectClass(imm);
            jmethodID hideSoftInput = immClass ? env->GetMethodID(
                immClass, "hideSoftInputFromWindow", "(Landroid/os/IBinder;I)Z") : nullptr;
            if (hideSoftInput && !ClearException(env))
                env->CallBooleanMethod(imm, hideSoftInput, windowToken, 0);
            ClearException(env);
            if (immClass)
                env->DeleteLocalRef(immClass);
        }

        jmethodID cancelLongPress = viewClass
            ? env->GetMethodID(viewClass, "cancelLongPress", "()V") : nullptr;
        if (cancelLongPress && !ClearException(env))
            env->CallVoidMethod(editText, cancelLongPress);
        ClearException(env);

        jmethodID setSelection = viewClass
            ? env->GetMethodID(viewClass, "setSelection", "(I)V") : nullptr;
        if (setSelection && !ClearException(env))
            env->CallVoidMethod(editText, setSelection, 0);
        ClearException(env);

        jmethodID clearFocus = viewClass
            ? env->GetMethodID(viewClass, "clearFocus", "()V") : nullptr;
        if (clearFocus && !ClearException(env))
            env->CallVoidMethod(editText, clearFocus);
        ClearException(env);

        SetViewBool(env, editText, "setEnabled", false);
        SetViewInt(env, editText, "setVisibility", kViewGone);

        // Release focus back to the game (window becomes not-focusable) but keep the
        // EditText window attached; nothing is removed, avoiding addView/removeView churn.
        UpdateWmFlags(env, wmParams, windowManager, editText,
                      kFlagsNotTouchable | kFlagsNotFocusable);

        if (windowToken)
            env->DeleteLocalRef(windowToken);
        if (viewClass)
            env->DeleteLocalRef(viewClass);
        if (imm)
            env->DeleteLocalRef(imm);
    }
    hideTaskPending.store(false);
}

void PollTextOnUiThread(JNIEnv* env)
{
    if (editText)
        UpdateSharedText(GetEditTextString(env));
    pollTaskPending.store(false);
}

void SetTextOnUiThread(JNIEnv* env, const std::string& text)
{
    if (editText)
        SetEditTextString(env, text);
}

void NativeRun(JNIEnv* env, jclass, jlong taskPtr)
{
    auto* task = reinterpret_cast<UiTask*>(static_cast<intptr_t>(taskPtr));
    if (!task)
        return;

    if (env->PushLocalFrame(64) != 0)
    {
        delete task;
        return;
    }

    jobject activity = AndroidPlatform::GetActivity();
    switch (task->type)
    {
    case UiTaskType::ShowKeyboard:
        ShowKeyboardOnUiThread(env, activity, task->text, task->syncText,
                               task->requestEpoch);
        break;
    case UiTaskType::HideKeyboard:
        HideKeyboardOnUiThread(env, activity);
        break;
    case UiTaskType::PollText:
        PollTextOnUiThread(env);
        break;
    case UiTaskType::SetText:
        SetTextOnUiThread(env, task->text);
        break;
    case UiTaskType::VerifyShow:
        VerifyShowKeyboardOnUiThread(env, activity, task->requestEpoch);
        break;
    }

    ClearException(env);
    env->PopLocalFrame(nullptr);
    delete task;
}

void NativeTextChanged(JNIEnv* env, jclass, jstring text)
{
    UpdateSharedText(JavaStringToStdString(env, text));
}

void RequestShowKeyboard(const std::string& text, bool syncText)
{
    std::uint64_t requestEpoch = 0;
    {
        std::lock_guard<std::mutex> lock(pendingShowMutex);
        keyboardRequested.store(true, std::memory_order_release);
        requestEpoch = showRequestEpoch.load(std::memory_order_acquire);
        pendingShowText = text;
        pendingShowSyncText = syncText;
        pendingShowEpoch = requestEpoch;
    }
    NoteKbActivity();
    // 新请求从头确认展示状态：清除旧的「已弹出」标记，避免残留 true 让本请求跳过
    // 自愈重试（否则会退回「要点击两次才能唤醒键盘」的旧 bug）。
    g_keyboardShown.store(false, std::memory_order_release);
    g_showRetryAttempts.store(0, std::memory_order_release);
    g_imeStalePolls.store(0, std::memory_order_release);
    // 记录本次键盘会话起点：键盘活跃时间戳只在会话初期的窗口期内持续刷新（见
    // UpdateKeyboardActivity），避免长时间打字期间「键盘最近活跃」守卫永不过期。
    g_KbSessionStartMs.store(KbNowMs(), std::memory_order_release);

    if (showTaskPending.exchange(true))
        return;

    if (!PostUiTask(new UiTask{
            UiTaskType::ShowKeyboard, text, syncText, requestEpoch}))
    {
        showTaskPending.store(false, std::memory_order_release);
    }
}

void RequestPollText()
{
    if (pollTaskPending.exchange(true))
        return;

    if (!PostUiTask(new UiTask{UiTaskType::PollText, {}}))
        pollTaskPending.store(false);
}

void RequestHideKeyboard()
{
    if (hideTaskPending.exchange(true))
        return;

    if (!PostUiTask(new UiTask{UiTaskType::HideKeyboard, {}}))
        hideTaskPending.store(false);
}

void RequestSetText(const std::string& text)
{
    PostUiTask(new UiTask{UiTaskType::SetText, text, false});
}

} // namespace

bool InputTextInternal(const char* label, const char* hint, char* buffer,
                       size_t bufferSize, ImGuiInputTextFlags flags)
{
    if (!label || !buffer || bufferSize == 0)
        return false;

    if (deactivateWidgetRequested.exchange(false, std::memory_order_acq_rel))
    {
        activeWidget = 0;
        nextPollTime = 0.0;
        // 注意：这里不能调用 ImGui::ClearActiveID()。本函数在绘制窗口控件的过程中执行，
        // 而 ImGui::NewFrame() 已经在本帧把当前触摸激活成了对应条目（例如标题栏拖动的
        // MoveId）。此时清掉全局 ActiveID 会经由 SetActiveID(0)->StopMouseMovingWindow()
        // 把「同一次手势」当场掐断：点击输入框后第一次拖动窗口/按下按钮必然失效；键盘
        // 被外部收起后 keyboardRequested 长时间残留，还会让每一次触摸都被取消，整个
        // ImGui 界面表现为无法移动。让 ImGui 自己管理 ActiveID 生命周期即可，桥接只需
        // 停止本控件的 IME 轮询/回写。
    }

    ImGuiID id = ImGui::GetID(label);
    bool changedByIme = false;
    if (activeWidget == id)
    {
        // Copy the IME text into the user buffer BEFORE ImGui::InputText so it loads it at the
        // start of the frame. We do NOT call ReloadActiveInputState() here: it sets
        // WantReloadUserBuf, which makes ImGui run InputTextReconcileUndoState at the end. With
        // ImGuiInputTextFlags_NoUndoRedo the undo stack is empty, and that reconcile reads
        // state->Stb->undostate -> null deref crash (observed when typing text into a numeric field).
        changedByIme = CopyTextToBuffer(ReadSharedText(), buffer, bufferSize);
    }

    ImGuiInputTextFlags displayFlags = flags | ImGuiInputTextFlags_ReadOnly | ImGuiInputTextFlags_NoUndoRedo;
    if (hint)
        ImGui::InputTextWithHint(label, hint, buffer, bufferSize, displayFlags);
    else
        ImGui::InputText(label, buffer, bufferSize, displayFlags);
    bool activated = ImGui::IsItemActivated();
    bool clicked = ImGui::IsItemClicked();

    if (activated || clicked)
    {
        bool wasActive = (activeWidget == id);
        activeWidget = id;
        nextPollTime = 0.0;
        RequestShowKeyboard(buffer, !wasActive);
    }

    if (activeWidget == id)
        UpdateInputFieldRect(id, ImGui::GetItemRectMin(), ImGui::GetItemRectMax());

    if (activeWidget == id)
    {
        double now = ImGui::GetTime();
        if (now >= nextPollTime)
        {
            RequestPollText();
            nextPollTime = now + kPollIntervalSeconds;
        }
    }

    return changedByIme;
}

bool InputText(const char* label, char* buffer, size_t bufferSize, ImGuiInputTextFlags flags)
{
    return InputTextInternal(label, nullptr, buffer, bufferSize, flags);
}

void PumpUiThread(JNIEnv* env)
{
    // 触摸驱动的快速恢复路径（与延迟自愈链互补）：键盘仍在请求中、但最近一次 showSoftInput
    // 没有被系统接受（g_keyboardShown 为 false）时，借下一次触摸立刻补做一次展示。注意这里
    // 用 g_keyboardShown 而不是 isAcceptingText()：后者在 restartInput 建立输入连接后就会
    // 返回 true，哪怕键盘窗口根本没弹出。
    //
    // 关键：这里绝不能同步执行展示逻辑。本函数由 TouchBridgeView.onTouchEvent（UI 线程触摸
    // 分发）回调触发，若在回调内同步调用 ShowKeyboardOnUiThread（requestFocus/restartInput/
    // showSoftInput/updateViewLayout），UI 线程会被阻塞——游戏照常渲染（渲染在单独线程），
    // 但整个界面的触摸输入全部排队失效，表现就是「界面没卡死、但摸不动」。因此一律改为
    // 异步投递到主线程消息队列（PostUiTask 已统一走 Handler.post）。
    if (!env || !keyboardRequested.load(std::memory_order_acquire) ||
        g_keyboardShown.load(std::memory_order_acquire))
        return;

    jobject activity = AndroidPlatform::GetActivity();
    if (!activity)
        return;

    std::string text;
    std::uint64_t requestEpoch = 0;
    {
        std::lock_guard<std::mutex> lock(pendingShowMutex);
        text = pendingShowText;
        requestEpoch = pendingShowEpoch;
    }

    if (!IsCurrentShowRequest(requestEpoch))
        return;

    // 已有展示任务在途（RequestShowKeyboard 或上一次触摸投递的）时交给任务/自愈重试链即可，
    // 避免每次触摸都重复投递展示任务。
    if (showTaskPending.exchange(true, std::memory_order_acq_rel))
        return;

    // 触摸驱动路径只重做展示，不重复同步文本（首次展示时已同步过），避免覆盖用户输入。
    if (!PostUiTask(new UiTask{UiTaskType::ShowKeyboard, text, false, requestEpoch}))
        showTaskPending.store(false, std::memory_order_release);
}

bool InputTextWithHint(const char* label, const char* hint, char* buffer,
                       size_t bufferSize, ImGuiInputTextFlags flags)
{
    return InputTextInternal(label, hint ? hint : "", buffer, bufferSize, flags);
}

bool InputInt(const char* label, int* value, int step, int step_fast,
              ImGuiInputTextFlags flags)
{
    if (!value)
        return false;

    const ImGuiID id = ImGui::GetID(label);
    std::array<char, 64>& buf = g_scalarBuffers[id];
    // Only show the formatted value while the widget is NOT being edited by the IME. When the
    // user is editing we must let the buffer follow the IME text (so the default value can be
    // deleted and a new number typed), instead of re-writing the value every frame.
    if (activeWidget != id)
        std::snprintf(buf.data(), buf.size(), "%d", *value);

    bool changed = InputTextInternal(
        label, nullptr, buf.data(), static_cast<size_t>(buf.size()),
        flags | ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsNoBlank);

    if (changed)
    {
        char* end = nullptr;
        const long parsed = std::strtol(buf.data(), &end, 10);
        if (end != buf.data() && *end == '\0')
        {
            *value = static_cast<int>(parsed);
        }
        else
        {
            // Empty or non-numeric text: keep the buffer as typed (allow emptying the field to
            // type a new value) and do NOT commit/revert. Return false (no value change).
            return false;
        }
    }

    return changed;
}

bool InputFloat(const char* label, float* value, float step, float step_fast,
                const char* format, ImGuiInputTextFlags flags)
{
    if (!value)
        return false;

    const ImGuiID id = ImGui::GetID(label);
    std::array<char, 64>& buf = g_scalarBuffers[id];
    if (activeWidget != id)
        std::snprintf(buf.data(), buf.size(), format ? format : "%.3f", *value);

    bool changed = InputTextInternal(
        label, nullptr, buf.data(), static_cast<size_t>(buf.size()),
        flags | ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsNoBlank);

    if (changed)
    {
        char* end = nullptr;
        const float parsed = std::strtof(buf.data(), &end);
        if (end != buf.data() && *end == '\0')
        {
            *value = parsed;
        }
        else
        {
            return false;
        }
    }

    return changed;
}

void DeleteBackward()
{
    if (activeWidget == 0)
        return;

    std::string text = ReadSharedText();
    if (text.empty())
        return;

    EraseLastUtf8Codepoint(text);
    UpdateSharedText(text);
    RequestSetText(text);
}

void SetText(const char* text)
{
    std::string value = text ? text : "";
    UpdateSharedText(value);
    RequestSetText(value);
}

void HideKeyboard()
{
    NoteKbActivity();
    CancelShowRequests();
    ClearInputFieldRect();
    activeWidget = 0;
    nextPollTime = 0.0;
    if (ImGui::GetCurrentContext())
        ImGui::ClearActiveID();
    RequestHideKeyboard();
}

void HandleTouchDown(JNIEnv* env, float x, float y)
{
    if (!env || !keyboardRequested.load(std::memory_order_acquire) ||
        IsInsideInputField(x, y))
    {
        return;
    }

    CancelShowRequests();
    ClearInputFieldRect();
    deactivateWidgetRequested.store(true, std::memory_order_release);
    // 异步收起：PostUiTask 统一走主线程 Handler 消息队列，绝不会在本触摸分发回调内
    // 内联执行 hideSoftInputFromWindow/updateViewLayout（那会阻塞 UI 线程、让整个界面
    // 触摸失效）。
    RequestHideKeyboard();
    NoteKbActivity();
}

bool WasKeyboardRecentlyActive(int64_t windowMs)
{
    const int64_t last = g_KbActivityMs.load(std::memory_order_acquire);
    if (last == 0)
        return false;
    return (KbNowMs() - last) < windowMs;
}

void UpdateKeyboardActivity(JNIEnv* env, jobject activity)
{
    if (!env || !activity)
        return;

    // 预加载桥接 dex（一次性）：把首次点击输入框时的 DexClassLoader/dexopt 从游戏渲染线程
    // 挪到生命周期监控线程。首次点击输入框的瞬间若在渲染线程（InvokeOnBeforeRender 回调内）
    // 执行 dexopt，游戏和 Overlay 会一起卡住数秒。这里走 bridgeMutex 与 PostUiTask 互斥，
    // 加载完成后所有投递都只是微秒级的缓存命中。
    {
        std::lock_guard<std::mutex> lock(bridgeMutex);
        if (!runnableClass && !bridgeFailed)
            EnsureRunnableBridgeLocked(env, activity);
    }

    // InputMethodManager.isAcceptingText() returns true while a soft keyboard is connected and
    // serving a text field in this app. That covers the game's own text fields as well as the
    // mod's hidden EditText. While it is true, keep the "keyboard recently active" timestamp
    // fresh so a focus regain caused by the keyboard is not treated as a background/resume cycle.
    const bool accepting = ImeIsAcceptingText(env, activity);

    if (accepting)
    {
        g_imeStalePolls.store(0, std::memory_order_release);
        // 只在键盘会话窗口期内持续刷新活跃时间戳（会话起点=桥接发起展示或首次检测到 IME
        // 接受文本）。会话进行超过 kKbSessionGuardMs 后停止刷新，让 ImGuiHost 的 1500ms
        // 重建守卫自然过期、surface 健康检查恢复正常运行——长时间打字不改变窗口布局，继续
        // 压制健康检查没有意义，反而会让真实故障（如 IME 引发的父 Surface 变化）无法自愈。
        int64_t sessionStart = g_KbSessionStartMs.load(std::memory_order_acquire);
        if (sessionStart == 0)
        {
            sessionStart = KbNowMs();
            g_KbSessionStartMs.store(sessionStart, std::memory_order_release);
        }
        if (KbNowMs() - sessionStart < kKbSessionGuardMs)
            NoteKbActivity();
        return;
    }

    // 看门狗：桥接仍认为键盘开着（keyboardRequested==true），但系统 IME 已不再接受文本，
    // 说明输入法被系统/输入法自身收起了（中文输入法的收起按钮、返回手势等），桥接拿不到
    // 任何回调。若放任 keyboardRequested 残留，HandleTouchDown() 会把之后每一次触摸都当成
    // 「在输入框外点按」并重新置起 deactivateWidgetRequested，配合 InputTextInternal 的去
    // 激活逻辑，整个 ImGui 界面会表现为无法操作。这里在连续多次轮询确认后重置桥接状态；
    // 真正的 EditText 收尾（清焦点、NOT_FOCUSABLE、GONE）通过 RequestHideKeyboard 放到
    // UI 线程执行，NoteKbActivity() 让随后到来的窗口焦点回归不被当成后台/恢复而触发重建。
    if (keyboardRequested.load(std::memory_order_acquire) &&
        !showTaskPending.load(std::memory_order_acquire) &&
        !hideTaskPending.load(std::memory_order_acquire))
    {
        // 自愈重试链「还在跑」＝从未成功展示（g_keyboardShown false）且尝试次数未用尽。
        // 这种情况不算「被外部收起」：等链自己确认或放弃，否则看门狗会在链跑完前把一次
        // 本可成功的展示请求掐掉，又退回「要点击第二次」。若已成功展示过（g_keyboardShown
        // true），链已停止，此时 !accepting 才代表键盘被外部收起，需要重置。
        const bool retryChainAlive =
            !g_keyboardShown.load(std::memory_order_acquire) &&
            g_showRetryAttempts.load(std::memory_order_acquire) < kMaxShowAttempts;
        if (retryChainAlive)
        {
            g_imeStalePolls.store(0, std::memory_order_release);
            return;
        }

        if (g_imeStalePolls.fetch_add(1, std::memory_order_acq_rel) + 1 >=
            kImeDismissedPollThreshold)
        {
            g_imeStalePolls.store(0, std::memory_order_release);
            CancelShowRequests();
            ClearInputFieldRect();
            deactivateWidgetRequested.store(false, std::memory_order_release);
            activeWidget = 0;
            nextPollTime = 0.0;
            NoteKbActivity();
            RequestHideKeyboard();
            LOGI("[ImGuiAndroidIme] IME dismissed externally; keyboard state reset");
        }
    }
    else
    {
        g_imeStalePolls.store(0, std::memory_order_release);
    }
}

} // namespace ImGuiAndroidIme
