namespace
{

constexpr char kDexFileName[] = "supernatural_touch_bridge.dex";
constexpr char kInstallerClassName[] = "com.andhook.TouchBridgeInstaller";

std::atomic<bool> g_Started{false};
std::atomic<bool> g_Stopping{false};
std::atomic<bool> g_Active{false};
std::atomic<bool> g_InstallPending{false};
std::thread g_Thread;
std::mutex g_BridgeMutex;
jclass g_InstallerClass = nullptr;
jmethodID g_InstallerCtor = nullptr;
uint64_t g_InstalledActivityGeneration = 0;
bool g_LoadFailed = false;

// NativeShouldCapture 在 UI 线程（TouchBridgeView.onTouchEvent）执行，而 ImGui 上下文
// （ctx->Windows 及其内部缓冲）由渲染线程每帧增删/移动。直接遍历 ctx->Windows 是与渲染
// 线程的数据竞争（可能正在 realloc/擦除 ImVector），命中野指针会让「是否捕获触摸」的
// 判断随机出错（整个界面表现为触摸无效）。改为渲染线程每帧把窗口矩形发布到锁保护的
// 快照，UI 线程只读快照（见 PublishCaptureRects）。
struct CaptureRect
{
    float minX = 0.0f;
    float minY = 0.0f;
    float maxX = 0.0f;
    float maxY = 0.0f;
};

std::mutex g_CaptureMutex;
std::vector<CaptureRect> g_CaptureRects;

bool ClearException(JNIEnv* env)
{
    if (!env || !env->ExceptionCheck())
        return false;
    env->ExceptionClear();
    return true;
}

JNIEnv* GetEnv(bool& needDetach)
{
    needDetach = false;
    JavaVM* vm = AndroidPlatform::GetJavaVM();
    if (!vm)
        return nullptr;

    JNIEnv* env = nullptr;
    if (vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) == JNI_OK)
        return env;
    if (vm->AttachCurrentThread(&env, nullptr) != JNI_OK)
        return nullptr;
    needDetach = true;
    return env;
}

void DetachEnv(bool needDetach)
{
    if (!needDetach)
        return;
    if (JavaVM* vm = AndroidPlatform::GetJavaVM())
        vm->DetachCurrentThread();
}

std::string GetAbsolutePath(JNIEnv* env, jobject file)
{
    if (!env || !file)
        return {};

    jclass fileClass = env->GetObjectClass(file);
    jmethodID getAbsolutePath = fileClass
        ? env->GetMethodID(fileClass, "getAbsolutePath", "()Ljava/lang/String;")
        : nullptr;
    jstring path = (getAbsolutePath && !ClearException(env))
        ? static_cast<jstring>(env->CallObjectMethod(file, getAbsolutePath))
        : nullptr;
    ClearException(env);

    std::string result;
    if (path)
    {
        const char* chars = env->GetStringUTFChars(path, nullptr);
        if (chars)
        {
            result = chars;
            env->ReleaseStringUTFChars(path, chars);
        }
        env->DeleteLocalRef(path);
    }
    if (fileClass)
        env->DeleteLocalRef(fileClass);
    return result;
}

std::string GetCodeCachePath(JNIEnv* env, jobject activity)
{
    if (!env || !activity)
        return {};

    jclass activityClass = env->GetObjectClass(activity);
    jmethodID getCodeCacheDir = activityClass
        ? env->GetMethodID(activityClass, "getCodeCacheDir", "()Ljava/io/File;")
        : nullptr;
    jobject cacheDir = (getCodeCacheDir && !ClearException(env))
        ? env->CallObjectMethod(activity, getCodeCacheDir)
        : nullptr;
    ClearException(env);

    if (!cacheDir)
    {
        jmethodID getCacheDir = activityClass
            ? env->GetMethodID(activityClass, "getCacheDir", "()Ljava/io/File;")
            : nullptr;
        cacheDir = (getCacheDir && !ClearException(env))
            ? env->CallObjectMethod(activity, getCacheDir)
            : nullptr;
        ClearException(env);
    }

    std::string result = GetAbsolutePath(env, cacheDir);
    if (cacheDir)
        env->DeleteLocalRef(cacheDir);
    if (activityClass)
        env->DeleteLocalRef(activityClass);
    return result;
}

bool WriteDex(JNIEnv* env, jobject activity, std::string& path)
{
    const std::string cachePath = GetCodeCachePath(env, activity);
    if (cachePath.empty())
        return false;

    path = cachePath + "/" + kDexFileName;
    std::remove(path.c_str());
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file)
        return false;
    file.write(reinterpret_cast<const char*>(kTouchBridgeDex),
               static_cast<std::streamsize>(kTouchBridgeDexSize));
    file.close();
    if (!file.good())
        return false;
    chmod(path.c_str(), 0444);
    return true;
}

void NativeOnTouch(JNIEnv* env, jclass, jint action, jint pointerIndex,
                   jintArray pointerIds, jfloatArray pointerXs,
                   jfloatArray pointerYs, jintArray pointerToolTypes,
                   jint pointerCount)
{
    if (!env || pointerCount <= 0 || !pointerIds || !pointerXs ||
        !pointerYs || !pointerToolTypes)
        return;

    const jsize idsLength = env->GetArrayLength(pointerIds);
    const jsize xsLength = env->GetArrayLength(pointerXs);
    const jsize ysLength = env->GetArrayLength(pointerYs);
    const jsize toolsLength = env->GetArrayLength(pointerToolTypes);
    const size_t count = static_cast<size_t>(std::max<jint>(
        0, std::min({pointerCount, idsLength, xsLength, ysLength, toolsLength})));
    if (count == 0 || ClearException(env))
        return;

    std::vector<jint> ids(count);
    std::vector<jfloat> xs(count);
    std::vector<jfloat> ys(count);
    std::vector<jint> tools(count);
    env->GetIntArrayRegion(pointerIds, 0, static_cast<jsize>(count), ids.data());
    env->GetFloatArrayRegion(pointerXs, 0, static_cast<jsize>(count), xs.data());
    env->GetFloatArrayRegion(pointerYs, 0, static_cast<jsize>(count), ys.data());
    env->GetIntArrayRegion(pointerToolTypes, 0, static_cast<jsize>(count), tools.data());
    if (ClearException(env))
        return;

    ImGui_ImplAndroid_HandleTouchEvent(
        action, pointerIndex, count,
        reinterpret_cast<const int32_t*>(ids.data()),
        reinterpret_cast<const float*>(xs.data()),
        reinterpret_cast<const float*>(ys.data()),
        reinterpret_cast<const int32_t*>(tools.data()));

    const int actionMasked = action & AMOTION_EVENT_ACTION_MASK;
    if (actionMasked == AMOTION_EVENT_ACTION_DOWN)
    {
        const size_t touchIndex = std::min(
            static_cast<size_t>(std::max(0, pointerIndex)), count - 1);
        const ImVec2 touchPosition = ImGui_ImplAndroid_TransformTouchPosition(
            xs[touchIndex], ys[touchIndex]);
        ImGuiAndroidIme::HandleTouchDown(
            env, touchPosition.x, touchPosition.y);
        // 只在 DOWN 上触发触摸驱动的键盘恢复（避免拖动/滑动时每个 MOVE 事件重复投递
        // 展示任务）；键盘展示本身已由延迟自愈重试链覆盖。
        ImGuiAndroidIme::PumpUiThread(env);
    }
}

void NativeInstalled(JNIEnv* env, jclass, jboolean installed)
{
    g_Active.store(installed == JNI_TRUE, std::memory_order_release);
    g_InstallPending.store(false, std::memory_order_release);
    if (installed == JNI_TRUE)
        ImGuiAndroidIme::PumpUiThread(env);
}

// 判断当前触摸点是否应被 ImGui 消费（落在 ImGui 窗口上），避免触摸穿透到游戏。
// 返回 true 时 Java 侧不再把事件转发给游戏。
bool NativeShouldCapture(JNIEnv*, jclass, jfloat x, jfloat y)
{
    // 仅按坐标命中判断，不看 io.WantCaptureMouse：
    // WantCaptureMouse 是上一帧算出来的（滞后一帧），用它会在点完 ImGui 后误把玩家下一个
    // 指向游戏控件的按下也拦掉，导致游戏要连点两次才响应。坐标命中用渲染线程发布的
    // 上一帧窗口布局快照即可（见 PublishCaptureRects），避免直接遍历正在被渲染线程修改的
    // ctx->Windows。
    const ImVec2 p = ImGui_ImplAndroid_TransformTouchPosition(x, y);
    std::lock_guard<std::mutex> lock(g_CaptureMutex);
    for (const CaptureRect& r : g_CaptureRects)
    {
        if (p.x >= r.minX && p.x <= r.maxX &&
            p.y >= r.minY && p.y <= r.maxY)
            return true;
    }
    return false;
}

bool EnsureClassLocked(JNIEnv* env, jobject activity)
{
    if (g_InstallerClass && g_InstallerCtor)
        return true;
    if (g_LoadFailed || !env || !activity)
        return false;

    std::string dexPath;
    if (!WriteDex(env, activity, dexPath))
    {
        g_LoadFailed = true;
        LOGE("[TouchEventBridge] failed to write bridge dex");
        return false;
    }

    jclass activityClass = env->GetObjectClass(activity);
    jmethodID getClassLoader = activityClass
        ? env->GetMethodID(activityClass, "getClassLoader", "()Ljava/lang/ClassLoader;")
        : nullptr;
    jobject parentLoader = (getClassLoader && !ClearException(env))
        ? env->CallObjectMethod(activity, getClassLoader)
        : nullptr;
    ClearException(env);
    if (activityClass)
        env->DeleteLocalRef(activityClass);
    if (!parentLoader)
        return false;

    jclass dexLoaderClass = env->FindClass("dalvik/system/DexClassLoader");
    jmethodID dexLoaderCtor = dexLoaderClass
        ? env->GetMethodID(dexLoaderClass, "<init>",
                           "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/ClassLoader;)V")
        : nullptr;
    jstring dexPathString = env->NewStringUTF(dexPath.c_str());
    jstring cachePathString = env->NewStringUTF(
        dexPath.substr(0, dexPath.find_last_of('/')).c_str());
    jobject dexLoader = (dexLoaderCtor && dexPathString && cachePathString &&
                         !ClearException(env))
        ? env->NewObject(dexLoaderClass, dexLoaderCtor, dexPathString,
                         cachePathString, nullptr, parentLoader)
        : nullptr;
    ClearException(env);

    jclass classLoaderClass = env->FindClass("java/lang/ClassLoader");
    jmethodID loadClass = classLoaderClass
        ? env->GetMethodID(classLoaderClass, "loadClass",
                           "(Ljava/lang/String;)Ljava/lang/Class;")
        : nullptr;
    jstring className = env->NewStringUTF(kInstallerClassName);
    jclass localClass = (dexLoader && loadClass && className &&
                         !ClearException(env))
        ? static_cast<jclass>(env->CallObjectMethod(dexLoader, loadClass, className))
        : nullptr;
    ClearException(env);

    if (localClass)
    {
        JNINativeMethod methods[] = {
            {const_cast<char*>("nativeOnTouch"),
             const_cast<char*>("(II[I[F[F[II)V"),
             reinterpret_cast<void*>(&NativeOnTouch)},
            {const_cast<char*>("nativeShouldCapture"),
             const_cast<char*>("(FF)Z"),
             reinterpret_cast<void*>(&NativeShouldCapture)},
            {const_cast<char*>("nativeInstalled"),
             const_cast<char*>("(Z)V"),
             reinterpret_cast<void*>(&NativeInstalled)},
        };
        if (env->RegisterNatives(localClass, methods, 3) != JNI_OK ||
            ClearException(env))
            localClass = nullptr;
    }

    if (localClass)
    {
        g_InstallerClass = static_cast<jclass>(env->NewGlobalRef(localClass));
        g_InstallerCtor = env->GetMethodID(
            g_InstallerClass, "<init>", "(Landroid/app/Activity;Z)V");
        if (!g_InstallerClass || !g_InstallerCtor || ClearException(env))
        {
            if (g_InstallerClass)
                env->DeleteGlobalRef(g_InstallerClass);
            g_InstallerClass = nullptr;
            g_InstallerCtor = nullptr;
        }
    }

    if (className) env->DeleteLocalRef(className);
    if (localClass) env->DeleteLocalRef(localClass);
    if (classLoaderClass) env->DeleteLocalRef(classLoaderClass);
    if (dexLoader) env->DeleteLocalRef(dexLoader);
    if (cachePathString) env->DeleteLocalRef(cachePathString);
    if (dexPathString) env->DeleteLocalRef(dexPathString);
    if (dexLoaderClass) env->DeleteLocalRef(dexLoaderClass);
    env->DeleteLocalRef(parentLoader);

    if (!g_InstallerClass || !g_InstallerCtor)
    {
        g_LoadFailed = true;
        LOGE("[TouchEventBridge] failed to load bridge class");
        return false;
    }
    return true;
}

bool PostInstaller(JNIEnv* env, jobject activity, bool install)
{
    std::lock_guard<std::mutex> lock(g_BridgeMutex);
    if (!EnsureClassLocked(env, activity))
        return false;

    jobject runnable = env->NewObject(
        g_InstallerClass, g_InstallerCtor, activity,
        install ? JNI_TRUE : JNI_FALSE);
    ClearException(env);

    jclass activityClass = env->GetObjectClass(activity);
    jmethodID runOnUiThread = activityClass
        ? env->GetMethodID(activityClass, "runOnUiThread",
                           "(Ljava/lang/Runnable;)V")
        : nullptr;
    if (runnable && runOnUiThread && !ClearException(env))
        env->CallVoidMethod(activity, runOnUiThread, runnable);
    const bool ok = !ClearException(env);
    if (activityClass)
        env->DeleteLocalRef(activityClass);
    if (runnable)
        env->DeleteLocalRef(runnable);
    return ok;
}

void WorkerMain()
{
    auto lastInstallRequest = std::chrono::steady_clock::time_point{};
    while (!g_Stopping.load(std::memory_order_acquire))
    {
        const auto now = std::chrono::steady_clock::now();
        if (g_InstallPending.load(std::memory_order_acquire) &&
            lastInstallRequest.time_since_epoch().count() != 0 &&
            now - lastInstallRequest >= std::chrono::seconds(3))
        {
            g_InstallPending.store(false, std::memory_order_release);
        }

        bool needDetach = false;
        JNIEnv* env = GetEnv(needDetach);
        jobject activity = AndroidPlatform::GetActivity();
        const uint64_t generation = AndroidPlatform::GetActivityGeneration();
        const bool needsInstall = activity &&
            (!g_Active.load(std::memory_order_acquire) ||
             generation != g_InstalledActivityGeneration ||
             lastInstallRequest.time_since_epoch().count() == 0 ||
             now - lastInstallRequest >= std::chrono::seconds(2));
        if (env && activity && needsInstall &&
            !g_InstallPending.exchange(true, std::memory_order_acq_rel))
        {
            if (PostInstaller(env, activity, true))
            {
                g_InstalledActivityGeneration = generation;
                lastInstallRequest = now;
            }
            else
                g_InstallPending.store(false, std::memory_order_release);
        }
        DetachEnv(needDetach);
        std::this_thread::sleep_for(std::chrono::milliseconds(300));
    }
    g_Active.store(false, std::memory_order_release);
    g_Started.store(false, std::memory_order_release);
}

} // namespace

void Start()
{
    if (g_Started.exchange(true, std::memory_order_acq_rel))
        return;
    g_Stopping.store(false, std::memory_order_release);
    g_Thread = std::thread(WorkerMain);
    g_Thread.detach();
}

void Stop()
{
    g_Stopping.store(true, std::memory_order_release);
    g_InstallPending.store(false, std::memory_order_release);
    g_Active.store(false, std::memory_order_release);
}

bool IsActive()
{
    return g_Active.load(std::memory_order_acquire);
}

void PublishCaptureRects()
{
    ImGuiContext* ctx = ImGui::GetCurrentContext();
    std::vector<CaptureRect> rects;
    if (ctx)
    {
        rects.reserve(static_cast<size_t>(ctx->Windows.Size));
        for (int i = 0; i < ctx->Windows.Size; ++i)
        {
            ImGuiWindow* w = ctx->Windows[i];
            if (!w || !w->Active || w->Collapsed || w->Hidden)
                continue;
            rects.push_back(CaptureRect{
                w->Pos.x, w->Pos.y,
                w->Pos.x + w->Size.x, w->Pos.y + w->Size.y});
        }
    }
    std::lock_guard<std::mutex> lock(g_CaptureMutex);
    g_CaptureRects.swap(rects);
}

} // namespace TouchEventBridge
