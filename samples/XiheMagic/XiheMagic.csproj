<Project Sdk="Microsoft.NET.Sdk">
  <!--
    羲和魔杖（MEAC 的 XiHeMagicItem 复刻）：物品 + 引导控制器 + 天降激光柱。
    激光柱主体走 Pylon 的屏幕效果着色器（assets/effects/XiheBeam.frag）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XiheMagic</AssemblyName>
    <RootNamespace>XiheMagic</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Pylon.ModLoader\Pylon.ModLoader.csproj" />
    <ProjectReference Include="..\..\managed\Pylon.ImGui\Pylon.ImGui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\runtime\bepinex-android\bepinex\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\interop\generated\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\..\interop\generated\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\interop\runtime\net10.0\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 屏幕效果 API 用 UnityEngine.Vector2 / Color -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\interop\generated\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
