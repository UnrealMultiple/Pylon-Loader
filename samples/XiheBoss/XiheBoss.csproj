<Project Sdk="Microsoft.NET.Sdk">
  <!--
    羲和 Boss（MEAC.Bosses.EoL.XiHe 的 1:1 复刻）：NPC 本体 + 9 种弹幕 + VisualEffect 组 + 屏幕着色器。
    所有发光/光束/环/太阳/天空/灰度/径向模糊都走 Pylon 的屏幕效果管线（assets/effects/*.frag）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XiheBoss</AssemblyName>
    <RootNamespace>XiheBoss</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Pylon.ModLoader\Pylon.ModLoader.csproj" />
    <ProjectReference Include="..\..\managed\Pylon.ImGui\Pylon.ImGui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\runtime\bepinex-android\bepinex\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\interop\generated\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\..\interop\generated\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\interop\runtime\net10.0\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 屏幕效果 API 用 UnityEngine.Vector2 / Color；贴图走 UnityEngine.Texture2D -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\interop\generated\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\..\interop\generated\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
