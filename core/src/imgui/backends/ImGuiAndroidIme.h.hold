#pragma once

#include <cstddef>
#include <jni.h>

#include "imgui.h"

namespace ImGuiAndroidIme
{

bool InputText(const char* label, char* buffer, size_t bufferSize, ImGuiInputTextFlags flags = 0);
bool InputTextWithHint(const char* label, const char* hint, char* buffer,
                       size_t bufferSize, ImGuiInputTextFlags flags = 0);
bool InputInt(const char* label, int* value, int step = 1, int step_fast = 100,
              ImGuiInputTextFlags flags = 0);
bool InputFloat(const char* label, float* value, float step = 0.0f, float step_fast = 0.0f,
                const char* format = "%.3f", ImGuiInputTextFlags flags = 0);
void SetText(const char* text);
void DeleteBackward();
void HideKeyboard();
void HandleTouchDown(JNIEnv* env, float x, float y);
void PumpUiThread(JNIEnv* env);

// Observe the system IME (including the game's own text fields, not just the mod's fields) and
// refresh the "keyboard recently active" timestamp while it is accepting text. The overlay
// lifecycle monitor calls this periodically so IME-induced window focus changes are never
// mistaken for a background/resume cycle (which would rebuild the Vulkan overlay and stutter the
// game's main thread).
void UpdateKeyboardActivity(JNIEnv* env, jobject activity);

// True if the on-screen keyboard was shown/hidden very recently (within windowMs). Used to
// suppress overlay-surface rebuilds on IME-induced focus changes (which would visibly flash).
bool WasKeyboardRecentlyActive(int64_t windowMs);

} // namespace ImGuiAndroidIme


