<?xml version="1.0" encoding="utf-8"?>
<!--
  依赖来源：
  · nuget.org 正常可用时照常还原；
  · 离线时所有包都从用户缓存（fallbackPackageFolders）取，只有 Disarm 由本仓库的
    local-feed 提供（它来自 BepInEx-Android 的 ARM64 构建，见 src/csharp/il2cppinterop/local-feed/README.md）；
  · 新解析的包写进工作区的 .work/nuget-packages，不动用户全局缓存（沙箱下不可写）。
-->
<configuration>
  <fallbackPackageFolders>
    <add key="user-cache" value="%USERPROFILE%\.nuget\packages" />
  </fallbackPackageFolders>
  <packageSources>
    <add key="local" value="src/csharp/il2cppinterop/local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>