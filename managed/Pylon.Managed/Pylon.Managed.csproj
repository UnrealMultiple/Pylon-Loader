<Project Sdk="Microsoft.NET.Sdk">

  <!--
    层：托管入口（我们自己的最小托管层）
    · 目标 net10.0 —— 与随包的 BCL（Microsoft.NETCore.App.runtime.android-arm64 10.0.12）一致
    · 由 CoreCLR 宿主（core/src/dotnet/CoreClrHost.cpp）用
      coreclr_create_delegate(host, domain, "Pylon.Managed", "Pylon.Managed.Entrypoint", "Start")
      解析并调用，跑在一个 64MB 栈的独立线程上
    · 现阶段只做一件事：证明 CoreCLR 起来了，并且能回调到我们自己的内核（PylonMod_Log）
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Pylon.Managed</AssemblyName>
    <RootNamespace>Pylon.Managed</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 进 TPA 后由 CoreCLR 直接加载，不打成单文件、不裁 BCL -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mod 契约：随宿主一起进 TPA，所有 Mod 共享同一份类型（隔离加载的前提） -->
    <ProjectReference Include="..\Pylon.Mod.Abstractions\Pylon.Mod.Abstractions.csproj" />

    <!-- 框架：宿主必须能在 0 个 Mod 时也起 UI / ImGui，所以这里直接依赖它，
         而不是等某个 Mod 把 Pylon.ModLoader.dll 带进来。 -->
    <ProjectReference Include="..\Pylon.ModLoader\Pylon.ModLoader.csproj" />

    <!-- 游戏代理：宿主需要读游戏状态（如类型表是否建好），typed 访问比按名字反射安全 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\interop\generated\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Harmony：契约里上下文要交出它的实例，所以这里是编译期依赖（运行时由宿主提供） -->
    <Reference Include="0Harmony">
      <HintPath>..\..\runtime\bepinex-android\bepinex\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- ARM64 补丁版 Il2CppInterop.Runtime：我们要给它的 P/Invoke 装解析器
         （它写的是桌面库名 GameAssembly，Android 上是 libil2cpp.so）。 -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\interop\runtime\net10.0\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>..\..\interop\runtime\net10.0\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
