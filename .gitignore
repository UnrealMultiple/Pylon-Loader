# 游戏二进制与 dump：绝不进 git（refs/ 里只保留说明文档 refs/README.md）
refs/*
!refs/README.md
*.apk
*.so
terraria*_assets/
src/app/src/main/jniLibs/
src/app/libs/
assets/bin/Data/

# 预置进启动器 debug 变体的游戏资源（来自 refs/，只在本机存在）
# 这是"用户导入"这一形态在本机构建的落地物，永不提交、永不进 release。
src/app/src/debug/assets/

# 本地构建缓存与脚手架：本机沙箱不允许写 ~/.gradle，构建缓存收进工作区
.gradle-home/
.toolchain-check/
.sandbox-check/
.dexcheck/

# 内核的中间产物（.o/.log）；产物 libpylon.so 已被上面的 *.so 与 jniLibs/ 规则覆盖
src/core/build-arm64/

# Il2CppInterop 生成的代理程序集：派生自游戏类型，不进 git（生成命令见 docs/构建-从零开始.md 第 4 节）
interop/generated/

# 生成的 On.* 源码（tools/hookgen → src/csharp/managed/Pylon.Hooks/Generated；换游戏版本会重新生成）
src/csharp/managed/Pylon.Hooks/Generated/

# 从 BepInEx-Android 发行 APK 里拆出来的运行时（CoreCLR/BCL/框架），派生自上游，不进 git
runtime/

# 由 tools/deploy-runtime.ps1 / Gradle 生成的 debug 运行时件（派生自游戏/上游，不进 git）
src/app/src/debug/assets/pylon-dotnet/
src/app/src/debug/assets/pylon-interop/
src/app/src/debug/assets/pylon-managed/
src/app/src/debug/assets/pylon-sample-mod/
src/app/src/debug/assets/pylon-samples/
src/app/src/debug/jniLibs/arm64-v8a/libcoreclr.so
src/app/src/debug/jniLibs/arm64-v8a/libclrjit.so
src/app/src/debug/jniLibs/arm64-v8a/libmscordaccore.so
src/app/src/debug/jniLibs/arm64-v8a/libmscordbi.so
src/app/src/debug/jniLibs/arm64-v8a/libSystem.*.so

# 本地配置与密钥
# debug.keystore 是本地生成的调试签名材料（本机沙箱不允许写 ~/.android），
# 因此不进 git：换机器时按 README 的一条命令重新生成即可。
keystore.properties
*.keystore
*.jks
local.properties
.gradle/
build/
outputs/

# C# 构建产物
bin/
obj/

# ---- 本机调试现场（不进 git）----
# .diag：抓的 logcat、tombstone、截图、反编译产物、临时下载的上游源码。
# 排查问题时很有用，但都属于"一次性的取证材料"，不该进仓库。
.diag/
# 一次性备份目录（改坏代码时手工留的现场）：保留在本机即可，不进 git。
.pre-restore-*/
.rollback-backup-*/
.snapshot-ref-migration/
# IDE 用户态文件
.vs/
.kotlin/
*.user
*.suo

# CMake/NDK 的 configure 中间产物（早期 externalNativeBuild 尝试留下的；内核改走 src/core/build.ps1）
.cxx/
/.work
/.work_screen.png